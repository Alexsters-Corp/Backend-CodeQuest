NODE_ENV=development

# Gateway
PORT=4000
FRONTEND_URL=http://localhost:5000
AUTH_SERVICE_URL=http://localhost:4001
LEARNING_SERVICE_URL=http://localhost:4002

# Shared DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=codequest
DB_NAME=codequest
DB_CONNECTION_LIMIT=10

# Shared JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP (auth-service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@codequest.local

# Feature flags (learning-service)
FEATURE_LEARNING_PATHS=true
FEATURE_LEARNING_LESSONS=true
FEATURE_LEARNING_PROGRESS=true
FEATURE_LEARNING_FAVORITES=true
FEATURE_CODE_EXECUTION_ENABLED=true
FEATURE_GUEST_ACCESS_ENABLED=true

# Judge0 (learning-service)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_EXECUTION_MAX_CODE_LENGTH=16000

# ─── Groq Cloud AI ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here           # Get from console.groq.com

FEATURE_AI_CONTENT_ENABLED=true          # Master switch for AI content generation
FEATURE_AI_EVALUATION_ENABLED=true       # Master switch for AI evaluation

AI_MODEL_CONTENT_GENERATION=llama-3.3-70b-versatile
AI_MODEL_EVALUATION=llama-3.3-70b-versatile
AI_MODEL_SAFETY_CHECK=llama-3.3-70b-versatile

AI_MAX_RETRIES=3                         # Retry attempts before failing
AI_TIMEOUT_MS=10000                      # Per-request timeout in milliseconds
